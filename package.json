{
  "name": "nextn",
  "version": "0.2.10",
  "private": true,
  "main": "electron.cjs",
  "homepage": "./",
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "scripts": {
    "dev": "next dev --turbopack -p 9002",
    "electron:dev": "concurrently -k \"npm:dev\" \"wait-on http://localhost:9002 && electron .\"",
    "electron:start": "concurrently -k \"npm:start\" \"wait-on http://localhost:9002 && set ELECTRON_START_URL=http://localhost:9002 && electron .\"",
    "electron:build": "npm run build && electron-builder",
    "build": "set \"NODE_ENV=production\" && next build",
    "start": "next start -p 9002",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "log-session": "tsx scripts/log-session.ts",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "es:import": "tsx src/scripts/elasticsearch-import.ts",
    "es:health": "tsx scripts/elasticsearch-health.ts",
    "find-duplicates": "tsx scripts/find-duplicates.ts",
    "merge-duplicates": "tsx scripts/merge-duplicates.ts"
  },
  "build": {
    "appId": "com.mechquote.app",
    "productName": "MechQuote",
    "directories": {
      "output": "dist"
    },
    "files": [
      ".next/**/*",
      "electron.cjs",
      "node_modules/**/*",
      "package.json",
      ".env",
      "dev.db"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "extraMetadata": {
      "main": "electron.cjs"
    }
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.30",
    "@ai-sdk/openai": "^3.0.30",
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/modifiers": "^7.0.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@elastic/elasticsearch": "^8.19.1",
    "@google/generative-ai": "^0.24.1",
    "@hookform/resolvers": "^4.1.3",
    "@prisma/adapter-better-sqlite3": "^7.3.0",
    "@radix-ui/react-accordion": "^1.2.3",
    "@radix-ui/react-alert-dialog": "^1.1.6",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-menubar": "^1.1.6",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-progress": "^1.1.2",
    "@radix-ui/react-radio-group": "^1.2.3",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slider": "^1.2.3",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-toast": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-query-devtools": "^5.91.3",
    "ai": "^6.0.94",
    "better-sqlite3": "^12.6.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^3.6.0",
    "embla-carousel-react": "^8.6.0",
    "fast-xml-parser": "^4.4.0",
    "lucide-react": "^0.475.0",
    "ml-matrix": "^6.12.1",
    "ml-regression": "^6.3.0",
    "multilayer-perceptron": "^1.0.7",
    "next": "15.3.8",
    "next-themes": "^0.3.0",
    "papaparse": "^5.4.1",
    "patch-package": "^8.0.0",
    "pdfjs-dist": "^5.4.624",
    "puppeteer": "^24.37.3",
    "react": "^18.3.1",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18.3.1",
    "react-dropzone": "^14.4.0",
    "react-hook-form": "^7.54.2",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^2.0.19",
    "recharts": "^2.15.1",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.0.1",
    "tailwindcss-animate": "^1.0.7",
    "tesseract.js": "^7.0.0",
    "xlsx": "^0.18.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@prisma/client": "6.19.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/papaparse": "^5.3.14",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "concurrently": "^9.2.1",
    "dotenv": "^17.2.3",
    "electron": "^40.4.0",
    "electron-builder": "^26.7.0",
    "electron-is-dev": "^3.0.1",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.3.0",
    "jest-environment-node": "^30.2.0",
    "module-alias": "^2.3.4",
    "postcss": "^8",
    "prisma": "6.19.2",
    "tailwindcss": "^3.4.1",
    "ts-jest": "^29.4.6",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "wait-on": "^9.0.4"
  }
}
